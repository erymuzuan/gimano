    "Gimano is a community-driven navigation app for Malaysia, built on OpenStreetMap data. Gimano's own code is open source (MIT).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manotu is a community-driven navigation app for Malaysia, built on OpenStreetMap data. Manotu's own code is open source (MIT)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Manotu ialah aplikasi navigasi yang dipacu komuniti untuk Malaysia, dibina menggunakan data OpenStreetMap. Kod Manotu sendiri sumber terbuka (MIT)."
          }
