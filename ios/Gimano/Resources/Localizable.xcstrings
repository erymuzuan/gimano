    "End-to-end encrypted. Gimano never stores your passphrase: if you lose it, this backup can't be recovered.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disulitkan hujung ke hujung. Gimano tidak pernah menyimpan kata laluan kamu: jika hilang, sandaran ini tidak dapat dipulihkan."
          }
        }
      }
    },
