    },
    "Gimano never knows who you are. Your public work is credited to this random pseudonym, which only your phone and your own backup can sign for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manotu never knows who you are. Your public work is credited to this random pseudonym, which only your phone and your own backup can sign for."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Manotu tidak pernah tahu siapa anda. Sumbangan awam anda dikreditkan kepada nama samaran rawak ini, yang hanya telefon dan sandaran anda boleh tandatangani."
          }
        }
