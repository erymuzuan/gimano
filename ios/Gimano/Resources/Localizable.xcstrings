    "24 words that recreate your pseudonym's key. Write them down and keep them private: anyone with them can sign as you. Not needed if you back up.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "24 perkataan yang mencipta semula kunci nama samaran anda. Tulis dan simpan secara peribadi: sesiapa yang memilikinya boleh menandatangani sebagai anda. Tidak perlu jika anda membuat sandaran."
          }
        }
      }
    },
    "24 words, separated by spaces": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "24 perkataan, dipisahkan dengan ruang"
          }
        }
      }
    },
