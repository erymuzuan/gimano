<?xml version="1.0" encoding="utf-8"?>
<!-- App-link association files for manotu.app (docs/events.md §5.1, §5.6): Android App Links (assetlinks.json) and iOS
     Universal Links (apple-app-site-association, no extension, must be served as application/json, no redirect).
     The extensionless MIME map is scoped to that one file with <location>, so nothing here is inherited by
     /.well-known/acme-challenge/ (Let's Encrypt HTTP-01, configured in the server-only root web.config and by
     Certify The Web). assetlinks.json already gets application/json from the site's web.config. -->
<configuration>
  <location path="apple-app-site-association">
    <system.webServer>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="application/json" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
