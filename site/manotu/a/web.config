<?xml version="1.0" encoding="utf-8"?>
<!-- Event invitation viewer (/a/, docs/events.md §5.1): IIS needs MIME types for ES modules. Scoped to this folder
     only; never edit the site root web.config. The plan is in the URL fragment, which browsers never send, and the
     page never transmits it; no-referrer keeps even the path out of outbound requests. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
