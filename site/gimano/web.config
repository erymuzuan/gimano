<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy /gimano folder (the brand is now Manotu, canonical site /manotu).
     Human pages redirect permanently: on bukitbunga.com to /manotu/..., on manotu.app (where this folder is the /gimano virtual directory) to the site root. Kept in place on purpose, because installed apps and
     subscribers use these URLs: download/version.json and the APKs (in-app updater), s/ (shared-drive
     links), altstore.json and logo.png (AltStore source), and fonts/img/style.css (assets those pages load).
     Scoped to this folder; never edit the www.bukitbunga.com root web.config. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="gimano-home-to-manotu" stopProcessing="true">
          <match url="^(index\.html)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?bukitbunga\.com$" /></conditions>
          <action type="Redirect" url="/manotu/" redirectType="Permanent" />
        </rule>
        <rule name="gimano-pages-to-manotu" stopProcessing="true">
          <match url="^(privacy|terms)(/.*)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?bukitbunga\.com$" /></conditions>
          <action type="Redirect" url="/manotu/{R:1}{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="gimano-download-page-to-manotu" stopProcessing="true">
          <match url="^download/(index\.html)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?bukitbunga\.com$" /></conditions>
          <action type="Redirect" url="/manotu/download/" redirectType="Permanent" />
        </rule>
        <rule name="gimano-home-to-manotu-app-root" stopProcessing="true">
          <match url="^(index\.html)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?manotu\.app$" /></conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="gimano-pages-to-manotu-app-root" stopProcessing="true">
          <match url="^(privacy|terms)(/.*)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?manotu\.app$" /></conditions>
          <action type="Redirect" url="/{R:1}{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="gimano-download-page-to-manotu-app-root" stopProcessing="true">
          <match url="^download/(index\.html)?$" />
          <conditions><add input="{HTTP_HOST}" pattern="^(www\.)?manotu\.app$" /></conditions>
          <action type="Redirect" url="/download/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
