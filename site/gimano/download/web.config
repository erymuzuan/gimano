<?xml version="1.0" encoding="utf-8"?>
<!-- Gimano APK downloads (/gimano/download only). Serves .apk with the Android MIME type
     and as an attachment. HTTPS is enforced by the site root; no redirects here. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
    <rewrite>
      <outboundRules>
        <rule name="Gimano APK as attachment">
          <match serverVariable="RESPONSE_Content_Disposition" pattern=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" pattern="\.apk$" />
          </conditions>
          <action type="Rewrite" value="attachment" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
