<?xml version="1.0" encoding="utf-8"?>
<!-- Gimano download folder only: serve Android packages correctly. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <remove fileExtension=".sha256" />
      <mimeMap fileExtension=".sha256" mimeType="text/plain" />
    </staticContent>
  </system.webServer>
  <location path="gimano-0.1.0.apk">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Disposition" value="attachment; filename=&quot;gimano-0.1.0.apk&quot;" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
