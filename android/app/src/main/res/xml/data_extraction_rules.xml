<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (API 31+): the on-device DB and private-place photos only.
     Device identity/auth (DataStore) is excluded: a restored phone registers as a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gimano.db" />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gimano.db" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
