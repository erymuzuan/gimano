# Release signing. Copy to keystore.properties (git-ignored). NEVER commit the keystore or passwords.
# The keystore lives OUTSIDE the repo. Back it up: without it, sideloaded users can never get updates.
storeFile=/Users/you/.android/gimano-release.jks
keyAlias=gimano
# Preferred: the password stays in the macOS Keychain and Gradle reads it at build time with
#   security find-generic-password -a gimano -s gimano-release-keystore -w
keychainService=gimano-release-keystore
keychainAccount=gimano
# Or (CI): set GIMANO_KEYSTORE_PASSWORD in the environment. storePassword=... here also works but is discouraged.
