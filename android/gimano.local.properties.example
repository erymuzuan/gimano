# Put in local.properties or gimano.local.properties (both git-ignored).
# OAuth client id for Google Drive backup (scope drive.appdata). Create it in Google Cloud Console:
# Android OAuth client for package my.gimano.app + the SHA-1 of your debug/release signing key.
gimano.googleAndroidClientId=

# Play Integrity for place votes: the Google Cloud project NUMBER (not the project id). Optional.
gimano.cloudProjectNumber=
