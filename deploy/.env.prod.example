# Production env for deploy/docker-compose.prod.yml on 172.30.30.150.
# Copy to deploy/.env.prod (git-ignored; chmod 600), replace every CHANGE_ME. Never commit it.
# Generate secrets on the server:
#   openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48       (JWT, >= 32 chars)
#   openssl rand -base64 32 | tr -d '\n=+/'                    (passwords; no ; = + / so they're connection-string safe)
# OpenSearch admin password rules: >= 8 chars with upper, lower, digit and special. E.g.
#   echo "Os-$(openssl rand -hex 12)-X9"

# Images (built by deploy/build-push.ps1 / build-push.sh)
REGISTRY=myhiro.azurecr.io
TAG=CHANGE_ME                 # git short sha printed by build-push (or 'latest')

# Secrets
JWT_SIGNING_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME

# Networking: publish the API only on the LAN interface that IIS ARR (.13) reaches
API_BIND=172.30.30.150
API_PORT=5080
TRUSTED_PROXIES=172.30.30.13
PUBLIC_BASE_URL=https://gimano-api.bukitbunga.com
SHARE_VIEWER_ORIGINS=https://www.bukitbunga.com
RATE_LIMIT_PER_MINUTE=600

# Keep the deprecated /me/places* until the apps ship the on-device store, then set false (410 Gone)
LEGACY_SAVED_PLACES=true

# Optional GitHub-issue sink for feedback (off unless both are set)
# FEEDBACK_GITHUB_REPO=owner/repo
# FEEDBACK_GITHUB_TOKEN=
