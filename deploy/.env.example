# Copy to deploy/.env and adjust. Never commit deploy/.env.

# Required: HMAC key for device JWTs, >= 32 characters (e.g. `openssl rand -base64 48`).
JWT_SIGNING_KEY=

DOTNET_ENVIRONMENT=Production

# Required: generate independent passwords (e.g. `openssl rand -hex 32` for each).
POSTGRES_DB=gimano
POSTGRES_USER=gimano
POSTGRES_PASSWORD=
RABBITMQ_USER=gimano
RABBITMQ_PASSWORD=
OPENSEARCH_HEAP=2g
# Postgres durability (dev default off for fast imports on slow Docker disks)
PG_FSYNC=off
VALHALLA_THREADS=8
# VALHALLA_TILE_URLS=https://download.geofabrik.de/asia/malaysia-singapore-brunei-latest.osm.pbf

# Host ports (defaults chosen to coexist with other stacks on the dev host WS556)
API_PORT=5080
POSTGIS_PORT=5433
OPENSEARCH_PORT=9210
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
VALHALLA_PORT=8002
BACKOFFICE_PORT=5090

# Back office (docs/back-office.md)
# Seals volunteered contact details: base64 of 32 random bytes (`openssl rand -base64 32`). Shared by api and backoffice;
# losing it makes existing sealed contacts unreadable (they expire within 90 days anyway).
CONTACT_ENCRYPTION_KEY=
# The maintainer email allowed to register and sign in (more: BackOffice__Maintainers__1 in docker-compose.yml).
BACKOFFICE_MAINTAINER=
# Where agents reach the API (shown in the back office's "Agent access" page).
BACKOFFICE_API_BASE_URL=http://100.101.150.9:5080

# Optional: open a GitHub issue for each feedback item (never includes contact details, device model or location)
# FEEDBACK_GITHUB_REPO=erymuzuan/gimano-feedback
# FEEDBACK_GITHUB_TOKEN=
