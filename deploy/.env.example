# Copy to deploy/.env (git-ignored) and replace every CHANGE_ME. Never commit deploy/.env.
# Generate secrets with:  openssl rand -base64 32        (PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))

# HMAC key for device JWTs, >= 32 characters:  openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME

POSTGRES_DB=gimano
POSTGRES_USER=gimano
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_USER=gimano
RABBITMQ_PASSWORD=CHANGE_ME

DOTNET_ENVIRONMENT=Production
OPENSEARCH_HEAP=2g
VALHALLA_THREADS=8
# VALHALLA_TILE_URLS=https://download.geofabrik.de/asia/malaysia-singapore-brunei-latest.osm.pbf
# Postgres durability (dev default off for fast imports on slow Docker disks; never off in production)
PG_FSYNC=off

# Host ports. Only the API is reachable from other machines; infrastructure binds to INFRA_BIND
# (127.0.0.1 by default). Set INFRA_BIND=0.0.0.0 only temporarily for debugging on a trusted network.
API_PORT=5080
INFRA_BIND=127.0.0.1
POSTGIS_PORT=5433
OPENSEARCH_PORT=9210
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
VALHALLA_PORT=8002

# Optional: open a GitHub issue for each feedback item (never includes device id; location rounded to 2 dp)
# FEEDBACK_GITHUB_REPO=owner/repo
# FEEDBACK_GITHUB_TOKEN=

# Contact details volunteered on feedback/crash reports are encrypted with this AES-256 key (base64, 32 bytes).
# Losing it makes stored contacts unreadable (they expire within 90 days anyway). Generate: openssl rand -base64 32
FEEDBACK_CONTACT_KEY=CHANGE_ME
# Maintainer view /api/v1/admin/* (header X-Admin-Key, >= 24 chars); leave empty to disable. openssl rand -base64 36
ADMIN_KEY=

# Back office (docs/back-office.md). Uses FEEDBACK_CONTACT_KEY above to reveal contacts.
BACKOFFICE_PORT=5090
# The maintainer email allowed to register and sign in (more: BackOffice__Maintainers__1 in docker-compose.yml).
BACKOFFICE_MAINTAINER=
# Where agents reach the API (shown on the back office's "Agent access" page).
BACKOFFICE_API_BASE_URL=http://100.101.150.9:5080
